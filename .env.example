# ============================================================
# AgriTech AI — Environment Variables Template
# Copy this file to .env and fill in your actual keys
# ============================================================

# OpenWeatherMap API (free at openweathermap.org)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Twilio WhatsApp (free sandbox at twilio.com)
# Step 1: Sign up at twilio.com
# Step 2: Go to Messaging → Try WhatsApp Sandbox
# Step 3: Paste your credentials below
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
